{
  "name": "agent-link",
  "version": "0.3.0",
  "description": "Cross-host Agent Link MCP plugin for Codex threads and Claude sessions.",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "node ./scripts/build.mjs",
    "check:dist": "node ./scripts/build.mjs --check",
    "check:approval-config":"node ./scripts/approval-config-check.js",
    "test:feedback": "node ./scripts/feedback-regression-test.js",
    "test:claude": "node ./tests/claude/mailbox.test.js && node ./tests/claude/session-index.test.js && node ./tests/claude/desktop-registry.test.js && node ./tests/claude/session-resolver.test.js && node ./tests/claude/send.test.js && node ./tests/claude/reply.test.js && node ./tests/claude/read-inbox.test.js && node ./tests/claude/wait.test.js && node ./tests/claude/notify-hook.test.js && node ./tests/claude/channel-bridge.test.js && node ./tests/shared/cross-host-receipt.test.js && node ./tests/shared/host-detect.test.js && node ./tests/shared/runtime-context.test.js",
    "test:codex-lifecycle": "node ./tests/codex/codex-binary.test.js && node ./tests/codex/app-server-lifecycle.test.js && node ./tests/codex/server-idle-churn.test.js && node ./tests/codex/chat-style-close.test.js",
    "measure:idle-churn": "node ./scripts/idle-churn-measure.js --idle-seconds 120",
    "test:claude-mailbox": "node ./tests/claude/mailbox.test.js",
    "test:claude-session-index": "node ./tests/claude/session-index.test.js",
    "test:claude-channel": "node ./tests/claude/channel-bridge.test.js",
    "test:claude-reply": "node ./tests/claude/reply.test.js",
    "test:host-detect": "node ./tests/shared/host-detect.test.js",
    "test:desktop-registry": "node ./tests/claude/desktop-registry.test.js",
    "test:session-resolver": "node ./tests/claude/session-resolver.test.js",
    "test:send": "node ./tests/claude/send.test.js",
    "test:notify-hook": "node ./tests/claude/notify-hook.test.js",
    "test:read-inbox": "node ./tests/claude/read-inbox.test.js",
    "test:wait": "node ./tests/claude/wait.test.js",
    "test:cross-host-receipt": "node ./tests/shared/cross-host-receipt.test.js",
    "test:runtime-context": "node ./tests/shared/runtime-context.test.js",
    "test:project-orchestrator": "node ./scripts/project-orchestrator-regression-test.js",
    "test:dependency-handoff": "node ./scripts/dependency-handoff-regression-test.js",
    "wf:agent-link": "node ./scripts/agent-wf-runner.js --suite ./wf/agent-link/suite.json",
    "wf:agent-link:live": "CODEX_AGENT_LINK_WF_LIVE=1 CODEX_AGENT_LINK_AUTOSTART=1 node ./scripts/agent-wf-runner.js --suite ./wf/agent-link/suite.json --live",
    "wf:agent-link:installed-live": "CODEX_AGENT_LINK_WF_LIVE=1 CODEX_AGENT_LINK_AUTOSTART=1 node ./scripts/agent-wf-runner.js --suite ./wf/agent-link/suite.json --live --installed-plugin-root",
    "smoke": "node ./scripts/mcp-smoke-test.js",
    "smoke:sidebar-state": "node ./scripts/sidebar-state-smoke-test.js",
    "smoke:app-server": "CODEX_AGENT_LINK_AUTOSTART=1 node ./scripts/app-server-smoke-test.js",
    "smoke:launch-thread": "CODEX_AGENT_LINK_AUTOSTART=1 node ./scripts/launch-thread-smoke-test.js",
    "smoke:launch-thread-persistence": "CODEX_AGENT_LINK_AUTOSTART=1 node ./scripts/launch-thread-persistence-test.js",
    "smoke:launch-thread-gui": "CODEX_AGENT_LINK_AUTOSTART=1 CODEX_AGENT_LINK_SMOKE_OPEN_GUI=1 CODEX_AGENT_LINK_SMOKE_GUI_DRY_RUN=1 node ./scripts/launch-thread-smoke-test.js"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.29.0",
    "ws": "^8.18.3"
  },
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "esbuild": "0.28.2"
  }
}
