{
  "name": "agent-link",
  "version": "0.6.0",
  "description": "Cross-host agent link: inspect, resolve, message, and audit Codex threads plus Claude Desktop and Claude Code sessions.",
  "author": {
    "name": "Brandon Gottshall",
    "url": "https://github.com/Brandon-Gottshall"
  },
  "homepage": "https://github.com/Brandon-Gottshall/agent-link",
  "repository": "https://github.com/Brandon-Gottshall/agent-link",
  "license": "MIT",
  "keywords": [
    "codex",
    "claude",
    "agents",
    "threads",
    "sessions",
    "mcp",
    "coordination"
  ],
  "skills": "./skills/",
  "mcpServers": {
    "codex-agent-link": {
      "command": "node",
      "args": [
        "${CLAUDE_PLUGIN_ROOT}/dist/server.mjs"
      ],
      "cwd": "${CLAUDE_PLUGIN_ROOT}",
      "env": {
        "AGENT_LINK_HOST": "claude"
      }
    }
  }
}
